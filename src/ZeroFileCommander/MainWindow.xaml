<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ZeroFileCommander.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ZeroFileCommander.Controls"
    Title="Zero File Commander">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" RowDefinitions="48,*,Auto" PreviewKeyDown="RootGrid_PreviewKeyDown">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F3" Invoked="View_Invoked" />
            <KeyboardAccelerator Key="F4" Invoked="Edit_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="Copy_Invoked" />
            <KeyboardAccelerator Key="F6" Invoked="Move_Invoked" />
            <KeyboardAccelerator Key="F7" Invoked="NewFolder_Invoked" />
            <KeyboardAccelerator Key="F8" Invoked="Delete_Invoked" />
            <KeyboardAccelerator Key="Delete" Invoked="Delete_Invoked" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="Refresh_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Başlık çubuğu (sürüklenebilir alan) -->
        <Grid x:Name="AppTitleBar" Padding="14,0,0,0" ColumnSpacing="10" ColumnDefinitions="Auto,Auto,*">
            <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png" Width="22" Height="22" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Zero File Commander" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid>

        <!-- Paneller -->
        <Grid Grid.Row="1" Padding="10,0,10,8" ColumnSpacing="8" ColumnDefinitions="*,*">
            <controls:FilePane x:Name="LeftPane" />
            <controls:FilePane x:Name="RightPane" Grid.Column="1" />
        </Grid>

        <!-- Fonksiyon tuşu çubuğu -->
        <Grid Grid.Row="2" Padding="10,6,10,10" ColumnDefinitions="*,Auto"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Click="View_Click">F3 Görüntüle</Button>
                <Button Click="Edit_Click">F4 Düzenle</Button>
                <Button Click="Copy_Click" Style="{StaticResource AccentButtonStyle}">F5 Kopyala →</Button>
                <Button Click="Move_Click">F6 Taşı →</Button>
                <Button Click="NewFolder_Click">F7 Yeni klasör</Button>
                <Button Click="Delete_Click">F8 Sil</Button>
            </StackPanel>
            <TextBlock x:Name="HintText" Grid.Column="1" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Tab: panel değiştir · Enter: aç · Backspace: üst klasör" />
        </Grid>
    </Grid>
</Window>
