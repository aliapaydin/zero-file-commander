<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ZeroFileCommander.Views.BatchRenameView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:ZeroFileCommander.Services">

    <Grid Width="860" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <!-- Şablonlar -->
        <Grid ColumnSpacing="16" ColumnDefinitions="2*,*">
            <StackPanel Spacing="8">
                <TextBox x:Name="NameMask" Header="Ad şablonu" Text="[N]" TextChanged="Option_Changed" FontFamily="Cascadia Mono, Consolas" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="[N] Ad" Tag="[N]" Click="Token_Click" ToolTipService.ToolTip="Orijinal ad (uzantısız). [N1-3]: ilk 3 karakter" />
                    <Button Content="[C] Sayaç" Tag="[C]" Click="Token_Click" />
                    <Button Content="[D] Tarih" Tag="[D]" Click="Token_Click" ToolTipService.ToolTip="Değiştirilme tarihi: yyyy-MM-dd" />
                    <Button Content="[T] Saat" Tag="[T]" Click="Token_Click" ToolTipService.ToolTip="Değiştirilme saati: HH-mm-ss" />
                    <Button Content="[P] Klasör" Tag="[P]" Click="Token_Click" ToolTipService.ToolTip="Üst klasörün adı" />
                </StackPanel>
            </StackPanel>
            <TextBox x:Name="ExtMask" Grid.Column="1" Header="Uzantı şablonu" Text="[E]" TextChanged="Option_Changed" FontFamily="Cascadia Mono, Consolas" />
        </Grid>

        <!-- Bul/değiştir, harf, sayaç -->
        <Grid Grid.Row="1" ColumnSpacing="12" ColumnDefinitions="*,*,Auto,Auto,Auto,Auto,Auto">
            <TextBox x:Name="FindBox" Header="Bul" TextChanged="Option_Changed" />
            <TextBox x:Name="ReplaceBox" Grid.Column="1" Header="Değiştir" TextChanged="Option_Changed" />
            <CheckBox x:Name="RegexCheck" Grid.Column="2" Content="Regex" VerticalAlignment="Bottom" Checked="Option_Changed" Unchecked="Option_Changed" />
            <ComboBox x:Name="CaseChoice" Grid.Column="3" Header="Harfler" SelectedIndex="0" SelectionChanged="Option_Changed" MinWidth="130">
                <x:String>Değiştirme</x:String>
                <x:String>küçük harf</x:String>
                <x:String>BÜYÜK HARF</x:String>
                <x:String>Baş Harfler</x:String>
            </ComboBox>
            <NumberBox x:Name="CounterStart" Grid.Column="4" Header="Sayaç başı" Value="1" SpinButtonPlacementMode="Compact" ValueChanged="Number_Changed" Width="110" />
            <NumberBox x:Name="CounterStep" Grid.Column="5" Header="Artış" Value="1" SpinButtonPlacementMode="Compact" ValueChanged="Number_Changed" Width="90" />
            <NumberBox x:Name="CounterDigits" Grid.Column="6" Header="Basamak" Value="2" Minimum="1" Maximum="9" SpinButtonPlacementMode="Compact" ValueChanged="Number_Changed" Width="100" />
        </Grid>

        <!-- Önizleme -->
        <Border Grid.Row="2" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                <Grid Padding="12,6" ColumnSpacing="12" ColumnDefinitions="*,40,*,170" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="Şimdiki ad" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="2" Text="Yeni ad" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="3" Text="Durum" Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
                <ListView x:Name="PreviewList" Grid.Row="1" Height="320" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:RenameRow">
                            <Grid ColumnSpacing="12" ColumnDefinitions="*,40,*,170">
                                <TextBlock Text="{x:Bind OldName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="12" Opacity="0.6" />
                                <TextBlock Grid.Column="2" Text="{x:Bind NewName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="{x:Bind StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <TextBlock x:Name="SummaryText" Grid.Row="3" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</UserControl>
