<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ZeroFileCommander.Views.SyncWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:ZeroFileCommander.Services"
    Title="Klasör senkronizasyonu — Zero File Commander">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" RowDefinitions="40,Auto,Auto,*,Auto">
        <Grid x:Name="TitleBarArea" Padding="14,0,0,0" ColumnSpacing="10" ColumnDefinitions="Auto,*">
            <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Grid.Column="1" Text="Klasör senkronizasyonu" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid>

        <!-- Klasörler -->
        <Grid Grid.Row="1" Padding="16,4,16,8" ColumnSpacing="12" ColumnDefinitions="*,Auto,*">
            <TextBox x:Name="LeftBox" Header="Sol klasör" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="Swap_Click" ToolTipService.ToolTip="Yer değiştir" AutomationProperties.Name="Yer değiştir">
                <FontIcon Glyph="&#xE8AB;" FontSize="14" />
            </Button>
            <TextBox x:Name="RightBox" Grid.Column="2" Header="Sağ klasör" />
        </Grid>

        <!-- Seçenekler -->
        <Grid Grid.Row="2" Padding="16,0,16,8" ColumnSpacing="16" ColumnDefinitions="Auto,Auto,Auto,*,Auto">
            <CheckBox x:Name="RecursiveCheck" Content="Alt klasörler" IsChecked="True" />
            <CheckBox x:Name="ContentCheck" Grid.Column="1" Content="İçeriği karşılaştır (yavaş)" />
            <CheckBox x:Name="ShowSameCheck" Grid.Column="2" Content="Aynı olanları göster" Checked="Filter_Changed" Unchecked="Filter_Changed" />
            <Button x:Name="CompareButton" Grid.Column="4" Click="Compare_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                    <TextBlock Text="Karşılaştır" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Sonuçlar -->
        <Border Grid.Row="3" Margin="16,0" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid RowDefinitions="Auto,*">
                <Grid Padding="12,6" ColumnSpacing="12" ColumnDefinitions="*,210,140,210" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="Dosya" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="Sol" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="2" Text="İşlem (tıkla: değiştir)" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="3" Text="Sağ" Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
                <ListView x:Name="ResultList" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:SyncEntry">
                            <Grid ColumnSpacing="12" ColumnDefinitions="*,210,140,210" Padding="0,2">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="13" Visibility="{x:Bind FolderVisibility}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind RelativePath}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind StateText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind LeftText}" VerticalAlignment="Center" FontSize="12" FontFamily="Cascadia Mono, Consolas" />
                                <Button Grid.Column="2" HorizontalAlignment="Stretch" Click="Action_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="{x:Bind ActionGlyph, Mode=OneWay}" FontSize="13" />
                                        <TextBlock Text="{x:Bind ActionText, Mode=OneWay}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Column="3" Text="{x:Bind RightText}" VerticalAlignment="Center" FontSize="12" FontFamily="Cascadia Mono, Consolas" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Karşılaştır'a bas" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Border>

        <!-- Alt çubuk -->
        <Grid Grid.Row="4" Padding="16,10,16,14" ColumnSpacing="12" ColumnDefinitions="*,Auto,Auto">
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Name="SummaryText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <ProgressBar x:Name="SyncProgress" Visibility="Collapsed" Maximum="100" />
            </StackPanel>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Durdur" Visibility="Collapsed" Click="Cancel_Click" />
            <Button x:Name="SyncButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="Sync_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                    <TextBlock Text="Senkronize et" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
