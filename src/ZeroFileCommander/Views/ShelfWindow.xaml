<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ZeroFileCommander.Views.ShelfWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ZeroFileCommander.Models"
    Title="Raf — Zero File Commander">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        RowDefinitions="36,*,Auto"
        AllowDrop="True"
        DragOver="Root_DragOver"
        DragLeave="Root_DragLeave"
        Drop="Root_Drop">
        <Grid x:Name="TitleBarArea" Padding="12,0,0,0" ColumnSpacing="8" ColumnDefinitions="Auto,*">
            <FontIcon Glyph="&#xE7B8;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Grid.Column="1" Text="Raf" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid>

        <ListView
            x:Name="ItemList"
            Grid.Row="1"
            Padding="6,0"
            SelectionMode="Extended"
            CanDragItems="True"
            ItemsSource="{x:Bind Items}"
            DragItemsStarting="ItemList_DragItemsStarting"
            DragItemsCompleted="ItemList_DragItemsCompleted"
            KeyDown="ItemList_KeyDown">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FileItem">
                    <Grid ColumnSpacing="8" ColumnDefinitions="22,*" Padding="0,4">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Opacity="{x:Bind GlyphOpacity, Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="20" Height="20" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            x:Name="EmptyHint"
            Grid.Row="1"
            Spacing="10"
            Padding="16"
            VerticalAlignment="Center"
            IsHitTestVisible="False">
            <FontIcon Glyph="&#xE896;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock
                Text="Dosyaları buraya bırak, sonra istediğin pencereye ya da monitöre sürükle."
                TextAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border
            x:Name="DropHint"
            Grid.RowSpan="3"
            Margin="6"
            CornerRadius="10"
            BorderThickness="2"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            Visibility="Collapsed"
            IsHitTestVisible="False" />

        <Grid Grid.Row="2" Padding="10,6,10,10" ColumnSpacing="6" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="1" Content="Temizle" Click="Clear_Click" />
        </Grid>
    </Grid>
</Window>
