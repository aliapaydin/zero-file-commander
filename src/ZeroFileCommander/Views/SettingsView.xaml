<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ZeroFileCommander.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer MaxHeight="560" Padding="0,0,16,0">
        <StackPanel Spacing="20" Width="460">

            <!-- Görünüm -->
            <StackPanel Spacing="10">
                <TextBlock Text="Görünüm" Style="{StaticResource SubtitleTextBlockStyle}" />
                <RadioButtons x:Name="ThemeChoice" Header="Tema" SelectionChanged="ThemeChoice_SelectionChanged" MaxColumns="3">
                    <x:String>Sisteme göre</x:String>
                    <x:String>Aydınlık</x:String>
                    <x:String>Karanlık</x:String>
                </RadioButtons>
                <ToggleSwitch x:Name="HoverToggle" Header="Üzerine gelince önizle (görsel, video, PDF)" Toggled="HoverToggle_Toggled" />
                <ToggleSwitch x:Name="GitToggle" Header="Git depolarında dal adını ve dosya durumlarını göster" Toggled="GitToggle_Toggled" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Bekleme" VerticalAlignment="Center" />
                    <Slider x:Name="HoverDelay" Width="220" Minimum="0" Maximum="1000" StepFrequency="50" ValueChanged="HoverDelay_ValueChanged" />
                    <TextBlock x:Name="HoverDelayText" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" />
                </StackPanel>
            </StackPanel>

            <!-- Güvenlik -->
            <StackPanel Spacing="10">
                <TextBlock Text="Güvenlik" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ToggleSwitch x:Name="PinToggle" Header="Uygulamayı 4 haneli PIN ile kilitle" Toggled="PinToggle_Toggled" />
                <StackPanel x:Name="PinEditor" Visibility="Collapsed" Spacing="8" Padding="12" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <PasswordBox x:Name="CurrentPin" Header="Mevcut PIN" MaxLength="4" InputScope="NumericPin" Width="160" HorizontalAlignment="Left" />
                    <PasswordBox x:Name="NewPin" Header="Yeni PIN (4 rakam)" MaxLength="4" InputScope="NumericPin" Width="160" HorizontalAlignment="Left" />
                    <PasswordBox x:Name="ConfirmPin" Header="Yeni PIN (tekrar)" MaxLength="4" InputScope="NumericPin" Width="160" HorizontalAlignment="Left" />
                    <TextBlock x:Name="PinMessage" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PinSave" Style="{StaticResource AccentButtonStyle}" Click="PinSave_Click" />
                        <Button Content="Vazgeç" Click="PinCancel_Click" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="PinChange" Content="PIN'i değiştir" Click="PinChange_Click" />
                <CheckBox x:Name="PinResumeCheck" Content="Arka plandan (tepsiden) açarken de PIN iste" Checked="PinResume_Changed" Unchecked="PinResume_Changed" />
                <TextBlock
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="PIN bu bilgisayardaki uygulamanın açılışını korur; Windows kullanıcısından bağımsızdır. Unutursanız: Windows Ayarlar → Uygulamalar → Zero File Commander → Gelişmiş seçenekler → Sıfırla (tüm ayarlar sıfırlanır)." />
            </StackPanel>

            <!-- Aktarımlar -->
            <StackPanel Spacing="10">
                <TextBlock Text="Kopyalama ve taşıma" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ToggleSwitch x:Name="QueueToggle" Header="Aktarım kuyruğunu kullan (duraklat/sürdür, çakışmaları sona bırak)" Toggled="QueueToggle_Toggled" />
                <ComboBox x:Name="ConflictChoice" Header="Hedefte aynı ad varsa" MinWidth="280" SelectionChanged="ConflictChoice_SelectionChanged">
                    <ComboBoxItem Content="Sona bırak ve sor" />
                    <ComboBoxItem Content="Daha yeniyse değiştir" />
                    <ComboBoxItem Content="Atla" />
                    <ComboBoxItem Content="Her zaman değiştir" />
                    <ComboBoxItem Content="İkisini de tut (yeniden adlandır)" />
                </ComboBox>
                <TextBlock
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Kapalıyken Windows'un kendi kopyalama penceresi kullanılır. Arşiv içi işlemler her zaman doğrudan yapılır." />
            </StackPanel>

            <!-- Arka plan -->
            <StackPanel Spacing="10">
                <TextBlock Text="Arka planda çalışma" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ToggleSwitch x:Name="BackgroundToggle" Header="Pencereyi kapatınca sistem tepsisinde çalışmaya devam et" Toggled="BackgroundToggle_Toggled" />
                <ToggleSwitch x:Name="MinimizeToggle" Header="Simge durumuna küçültünce tepsiye gizle" Toggled="MinimizeToggle_Toggled" />
                <TextBlock
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Tepsiye gizlenince görev çubuğu düğmesi kaybolur; indirme ilerlemesi o sırada tepsi simgesinin ipucunda görünür." />
            </StackPanel>

            <!-- İndirmeler -->
            <StackPanel Spacing="10">
                <TextBlock Text="İndirmeler" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ToggleSwitch x:Name="DownloadsToggle" Header="İndirme yöneticisini etkinleştir" Toggled="DownloadsToggle_Toggled" />
                <StackPanel x:Name="DownloadOptions" Spacing="10">
                    <Grid ColumnSpacing="8" ColumnDefinitions="*,Auto">
                        <TextBox x:Name="FolderBox" Header="İndirme klasörü" IsReadOnly="True" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Seç…" Click="PickFolder_Click" />
                    </Grid>
                    <ToggleSwitch x:Name="ClipboardToggle" Header="Panoya kopyalanan indirme bağlantılarını yakala" Toggled="ClipboardToggle_Toggled" />
                    <TextBlock
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Windows'ta tarayıcıların indirmelerini devralan bir 'varsayılan indirici' ayarı yok. Şimdilik bağlantıyı kopyalaman yeterli; tarayıcı eklentisi yol haritasında." />
                </StackPanel>
            </StackPanel>

            <!-- Yerleşim -->
            <StackPanel Spacing="10">
                <TextBlock Text="Yerleşim" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Pencere konumları/boyutları, panel genişlikleri ve son açık klasörler otomatik hatırlanır. Ayırıcıya çift tıklamak o ayırıcıyı varsayılana döndürür." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Yerleşimi sıfırla" Click="ResetLayout_Click" />
                    <Button Content="Tüm ayarları sıfırla" Click="ResetAll_Click" />
                </StackPanel>
                <TextBlock x:Name="ResetStatus" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>

            <!-- Bildirimler -->
            <StackPanel Spacing="10">
                <TextBlock Text="Bildirimler" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="PositionChoice" Header="Bildirim kutusunun konumu" Width="260" SelectionChanged="PositionChoice_SelectionChanged">
                    <x:String>Sağ alt</x:String>
                    <x:String>Sağ üst</x:String>
                    <x:String>Sol alt</x:String>
                    <x:String>Sol üst</x:String>
                    <x:String>Alt orta</x:String>
                </ComboBox>
                <Button Content="Örnek bildirim göster" Click="TestNotification_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
