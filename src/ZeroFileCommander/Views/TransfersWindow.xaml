<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ZeroFileCommander.Views.TransfersWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:ZeroFileCommander.Services"
    Title="Aktarımlar — Zero File Commander">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" RowDefinitions="40,Auto,*,Auto">
        <Grid x:Name="TitleBarArea" Padding="14,0,0,0" ColumnSpacing="10" ColumnDefinitions="Auto,*">
            <FontIcon Glyph="&#xE8C8;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Grid.Column="1" Text="Aktarımlar" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid>

        <Grid Grid.Row="1" Padding="16,4,16,10" ColumnSpacing="12" ColumnDefinitions="Auto,*">
            <ComboBox x:Name="PolicyChoice" Header="Hedefte aynı adlı dosya varsa (yeni işler için)" Width="340" SelectionChanged="PolicyChoice_SelectionChanged">
                <x:String>Diğerlerine devam et, sonra sor</x:String>
                <x:String>Yalnızca daha yeniyse değiştir</x:String>
                <x:String>Atla</x:String>
                <x:String>Üzerine yaz</x:String>
                <x:String>İkisini de tut (yeni ada kopyala)</x:String>
            </ComboBox>
        </Grid>

        <ListView
            Grid.Row="2"
            Padding="8,0,8,8"
            SelectionMode="None"
            ItemsSource="{x:Bind Manager.Jobs}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:TransferJob">
                    <Border
                        Padding="14,12"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid ColumnSpacing="12" RowSpacing="6" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Text="{x:Bind RouteText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Grid.Row="2" Maximum="100" Value="{x:Bind Progress, Mode=OneWay}" IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" />
                            <TextBlock Grid.Row="3" Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="4" Text="{x:Bind Current, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />

                            <!-- Çakışma kararı (iş durmadan sona bırakılanlar) -->
                            <Border
                                Grid.Row="5"
                                Grid.ColumnSpan="2"
                                Padding="10"
                                CornerRadius="6"
                                Visibility="{x:Bind ConflictVisibility, Mode=OneWay}"
                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="14" />
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind services:Loc.T('Kalan çakışmalar için:')}" />
                                    <Button Content="{x:Bind services:Loc.T('Daha yeniyse değiştir')}" Tag="1" Click="Resolve_Click" Style="{StaticResource AccentButtonStyle}" />
                                    <Button Content="{x:Bind services:Loc.T('Atla')}" Tag="2" Click="Resolve_Click" />
                                    <Button Content="{x:Bind services:Loc.T('Üzerine yaz')}" Tag="3" Click="Resolve_Click" />
                                    <Button Content="{x:Bind services:Loc.T('İkisini de tut')}" Tag="4" Click="Resolve_Click" />
                                </StackPanel>
                            </Border>
                            <TextBlock
                                Grid.Row="5"
                                Grid.ColumnSpan="2"
                                Text="{x:Bind ErrorSummary, Mode=OneWay}"
                                Visibility="{x:Bind ErrorVisibility, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                            <StackPanel Grid.Column="1" Grid.RowSpan="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                <Button Click="Pause_Click" Visibility="{x:Bind PauseVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind services:Loc.T('Duraklat')}" AutomationProperties.Name="{x:Bind services:Loc.T('Duraklat')}"><FontIcon Glyph="&#xE769;" FontSize="13" /></Button>
                                <Button Click="Resume_Click" Visibility="{x:Bind ResumeVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind services:Loc.T('Devam et')}" AutomationProperties.Name="{x:Bind services:Loc.T('Devam et')}"><FontIcon Glyph="&#xE768;" FontSize="13" /></Button>
                                <Button Click="Cancel_Click" Visibility="{x:Bind CancelVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind services:Loc.T('İptal')}" AutomationProperties.Name="{x:Bind services:Loc.T('İptal')}"><FontIcon Glyph="&#xE711;" FontSize="13" /></Button>
                                <Button Click="Remove_Click" Visibility="{x:Bind RemoveVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind services:Loc.T('Listeden kaldır')}" AutomationProperties.Name="{x:Bind services:Loc.T('Listeden kaldır')}"><FontIcon Glyph="&#xE74D;" FontSize="13" /></Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="Kuyruk boş"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

        <Grid Grid.Row="3" Padding="16,8,16,12" ColumnDefinitions="*,Auto" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="1" Content="Bitenleri temizle" Click="ClearFinished_Click" />
        </Grid>
    </Grid>
</Window>
