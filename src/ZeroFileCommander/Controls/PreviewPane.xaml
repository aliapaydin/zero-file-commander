<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ZeroFileCommander.Controls.PreviewPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Padding="12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="10">
        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Text="ÖNİZLEME"
                    VerticalAlignment="Center"
                    CharacterSpacing="60"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button
                    Grid.Column="1"
                    Padding="6"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CloseButton_Click"
                    ToolTipService.ToolTip="Önizleme panelini kapat (Ctrl+Q)"
                    AutomationProperties.Name="Önizleme panelini kapat">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>

            <Grid
                x:Name="Stage"
                Grid.Row="1"
                CornerRadius="8"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <!-- Görseller ve PDF sayfaları: panel genişliğine sığar, aşağı kaydırılır -->
                <ScrollViewer
                    x:Name="ImageScroller"
                    Visibility="Collapsed"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    ViewChanged="ImageScroller_ViewChanged"
                    SizeChanged="ImageScroller_SizeChanged">
                    <StackPanel x:Name="PageStack" Padding="6" Spacing="8" />
                </ScrollViewer>
                <MediaPlayerElement
                    x:Name="Player"
                    AreTransportControlsEnabled="True"
                    Stretch="Uniform"
                    Visibility="Collapsed" />
                <ScrollViewer
                    x:Name="TextScroller"
                    Visibility="Collapsed"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled">
                    <TextBlock
                        x:Name="PreviewText"
                        Padding="12"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                </ScrollViewer>
                <!-- Klasör içeriği: yalnızca bilgi amaçlı, sönük ve tıklanamaz -->
                <ScrollViewer
                    x:Name="FolderScroller"
                    Visibility="Collapsed"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="10" Spacing="10">
                        <TextBlock x:Name="FolderSummary" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <VariableSizedWrapGrid
                            x:Name="FolderGrid"
                            Orientation="Horizontal"
                            ItemWidth="84"
                            ItemHeight="96"
                            Opacity="0.55"
                            IsHitTestVisible="False" />
                    </StackPanel>
                </ScrollViewer>
                <!-- Office vb. için Windows önizleyicisinin çizdiği alan -->
                <Border x:Name="HandlerSurface" Visibility="Collapsed" Background="White" />
                <StackPanel
                    x:Name="Placeholder"
                    Spacing="10"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                    <FontIcon x:Name="PlaceholderIcon" Glyph="&#xE8A5;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        x:Name="PlaceholderText"
                        Text="Bir dosya seç"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="220"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ProgressRing x:Name="LoadingRing" Width="28" Height="28" IsActive="False" />
            </Grid>

            <!-- PDF sayfa gezintisi -->
            <Grid x:Name="PageBar" Grid.Row="2" Visibility="Collapsed" ColumnSpacing="6" ColumnDefinitions="Auto,*,Auto">
                <Button Click="PrevPage_Click" ToolTipService.ToolTip="Önceki sayfa" AutomationProperties.Name="Önceki sayfa">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                </Button>
                <TextBlock x:Name="PageText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                <Button Grid.Column="2" Click="NextPage_Click" ToolTipService.ToolTip="Sonraki sayfa" AutomationProperties.Name="Sonraki sayfa">
                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                </Button>
            </Grid>

            <StackPanel Grid.Row="3" Spacing="4">
                <TextBlock x:Name="NameText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" />
                <TextBlock x:Name="KindText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" Margin="0,6,0,0">
                    <TextBlock Text="Boyut" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="SizeText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Row="1" Text="Değiştirilme" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="DateText" Grid.Row="1" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Row="2" Text="Bilgi" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="ExtraText" Grid.Row="2" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
