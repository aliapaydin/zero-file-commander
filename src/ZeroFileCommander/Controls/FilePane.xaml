<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ZeroFileCommander.Controls.FilePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ZeroFileCommander.Models"
    GotFocus="OnGotFocus">

    <Border
        x:Name="RootBorder"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="10">
        <Grid x:Name="PaneGrid" RowDefinitions="Auto,Auto,*,Auto">

            <!-- Yol çubuğu -->
            <Grid Grid.Row="0" Padding="8" ColumnSpacing="6" ColumnDefinitions="Auto,*">
                <Button
                    Click="UpButton_Click"
                    ToolTipService.ToolTip="Üst klasör (Backspace)"
                    AutomationProperties.Name="Üst klasör">
                    <FontIcon Glyph="&#xE74A;" FontSize="14" />
                </Button>
                <TextBox
                    x:Name="PathBox"
                    Grid.Column="1"
                    KeyDown="PathBox_KeyDown"
                    AutomationProperties.Name="Klasör yolu" />
            </Grid>

            <!-- Sütun başlıkları -->
            <Grid
                Grid.Row="1"
                Padding="16,4,16,4"
                ColumnSpacing="8"
                ColumnDefinitions="24,*,90,130"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <TextBlock Grid.Column="1" Text="Ad" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="Boyut" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="3" Text="Değiştirilme" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <!-- Dosya listesi -->
            <ListView
                x:Name="FileList"
                Grid.Row="2"
                ItemsSource="{x:Bind Items}"
                SelectionMode="Extended"
                IsDoubleTapEnabled="True"
                CanDragItems="True"
                AllowDrop="True"
                DoubleTapped="List_DoubleTapped"
                KeyDown="List_KeyDown"
                SelectionChanged="List_SelectionChanged"
                RightTapped="List_RightTapped"
                DragItemsStarting="List_DragItemsStarting"
                DragItemsCompleted="List_DragItemsCompleted"
                DragOver="List_DragOver"
                DragLeave="List_DragLeave"
                Drop="List_Drop"
                AutomationProperties.Name="Dosyalar">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinHeight" Value="30" />
                        <Setter Property="Padding" Value="8,0,8,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:FileItem">
                        <Grid
                            ColumnSpacing="8"
                            ColumnDefinitions="24,*,90,130"
                            Background="Transparent"
                            PointerEntered="Row_PointerEntered"
                            PointerExited="Row_PointerExited">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind ModifiedText}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Bırakma ipucu -->
            <Border
                x:Name="DropHint"
                Grid.Row="2"
                Margin="8"
                Padding="12,8"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                CornerRadius="8"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                Background="{ThemeResource AccentFillColorDefaultBrush}">
                <TextBlock x:Name="DropHintText" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </Border>

            <!-- Durum satırı -->
            <TextBlock
                x:Name="StatusText"
                Grid.Row="3"
                Margin="12,6,12,8"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Üzerine gelince hızlı bakış -->
            <Popup x:Name="HoverPopup" Grid.RowSpan="4" IsLightDismissEnabled="False">
                <Border
                    Width="300"
                    Padding="10"
                    CornerRadius="12"
                    IsHitTestVisible="False"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Border CornerRadius="8" MaxHeight="220" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Image x:Name="HoverImage" Stretch="Uniform" MaxHeight="220" />
                        </Border>
                        <TextBlock x:Name="HoverTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="HoverMeta" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
